    {
      "id": "KIyN7Mf8S6pkRYJge2YPz",
      "type": "text",
      "x": 3884.8346267939714,
      "y": 76.51243552729721,
      "width": 968,
      "height": 3250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
