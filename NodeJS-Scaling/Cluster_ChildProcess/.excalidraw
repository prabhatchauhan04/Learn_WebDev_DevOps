    {
      "id": "3wExKnQuQiFPZCkI2C5FX",
      "type": "text",
      "x": 5005.571141640592,
      "y": 107.57322749246839,
      "width": 935,
      "height": 2925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
