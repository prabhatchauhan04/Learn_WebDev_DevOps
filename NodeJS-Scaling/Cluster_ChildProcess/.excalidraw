    {
      "id": "Yf1u-mwNy_umRssNMS1yL",
      "type": "text",
      "x": -2578.978922384519,
      "y": 123.78540408370941,
      "width": 1199,
      "height": 8050,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
